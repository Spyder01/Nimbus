# Copy to .env (git-ignored). The worker reads it from the folder it is started in; real environment variables win.
# Everything is documented in docs/configuration.md.

# --- Database: the same one as the backend (required) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nimbus
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=changeme

# --- Optional ---
# Workers sharing a pool share default settings. Each worker takes the next free name in its pool (default-0, default-1, ...).
# WORKER_POOL=default
# Ask for an exact name instead of being given one.
# WORKER_NAME=
# Where /healthz, /config and /actuator are served. Give each worker on one machine its own port.
# WORKER_HTTP_PORT=8081
# How many jobs this worker runs at once (1-100) and how long a job's lease is, in seconds (60-86400).
# The admin page can change both while the worker runs.
WORKER_PARALLEL_JOBS=4
WORKER_LEASE_SECONDS=1800

# --- What a job does: "fake" (default, deploys nothing) or "kubernetes" ---
# WORKER_RUNNER=fake
# WORKER_FAKE_JOB_SECONDS=15

# --- Only for WORKER_RUNNER=kubernetes ---
# Outside a cluster: a kubeconfig and the context in it to deploy to (the context is required, never defaulted).
# WORKER_KUBECONFIG=
# WORKER_KUBE_CONTEXT=kind-nimbus-dev
# Inside a cluster, use the pod's service account instead.
# WORKER_KUBE_IN_CLUSTER=true
# How long a container gets to become ready, in seconds (30-3600).
# WORKER_DEPLOY_TIMEOUT_SECONDS=300
# For public containers: the domain addresses end in, and the shared Gateway as <namespace>/<name>.
# WORKER_BASE_DOMAIN=localhost
# WORKER_GATEWAY=nimbus-gateway/nimbus
