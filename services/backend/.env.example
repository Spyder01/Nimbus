# Copy to .env and adjust. Spring reads these as OS environment variables
# (load via your IDE run config, or `set -a; source .env; set +a`).
# Defaults mirror ../../k8 (namespace "nimbus"). Locally use localhost (port-forward);
# in-cluster use the *-rw services.

# --- Postgres (k8/postgres: service postgres-rw:5432, secret postgres-secret) ---
# in-cluster host: postgres-rw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nimbus
POSTGRES_USER=nimbus
# dev placeholder from k8/postgres/secret.yaml
POSTGRES_PASSWORD=changeme

# --- Redis (k8/redis: service redis-rw:6379, no auth configured) ---
# true: sessions stored in Redis (needs Redis reachable). false: in-memory sessions, Redis not required.
REDIS_ENABLED=false
# in-cluster host: redis-rw
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- GitHub OAuth (GitHub > Settings > Developer settings > OAuth Apps) ---
# Callback URL to register: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
