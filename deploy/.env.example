# Copy to .env (docker compose reads it automatically) and fill in the values marked REQUIRED.

# --- Which images to run ---------------------------------------------------------------------------------------
# REQUIRED: the Docker Hub account the images are published under (nimbus-backend and nimbus-worker).
DOCKERHUB_USERNAME=
# Image tag to run: a release such as v0.1.0, a commit tag, or latest.
NIMBUS_TAG=latest
# Or name the images yourself, to use a private registry or locally built images.
# BACKEND_IMAGE=registry.example.com/nimbus-backend:v0.1.0
# WORKER_IMAGE=registry.example.com/nimbus-worker:v0.1.0

# --- Database ---------------------------------------------------------------------------------------------------
POSTGRES_USER=nimbus
# REQUIRED: choose a password. It is only used between the containers; Postgres is not published to your machine.
POSTGRES_PASSWORD=
POSTGRES_DB=nimbus

# --- Sign-in: a GitHub OAuth App (docs/getting-started.md explains how to create one) ---------------------------
# Its callback URL must be http://localhost:8080/login/oauth2/code/github (use your own host and port if you change them).
# REQUIRED
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Where it listens --------------------------------------------------------------------------------------------
BACKEND_PORT=8080

# --- Workers ------------------------------------------------------------------------------------------------------
WORKER_REPLICAS=3
WORKER_POOL=default
WORKER_PARALLEL_JOBS=4
# "fake" pretends to deploy (nothing runs); "kubernetes" needs docker-compose.kubernetes.yml and the settings below.
WORKER_RUNNER=fake

# --- Only with docker-compose.kubernetes.yml ----------------------------------------------------------------------
# A kubeconfig the containers can use, and the context in it to deploy to.
# KUBECONFIG_FILE=/absolute/path/to/kubeconfig
# KUBE_CONTEXT=kind-nimbus-dev
# Docker network of a local kind cluster (default "kind"), so the workers can reach its API server.
# KIND_NETWORK=kind
# For public containers: the domain their addresses end in, and the shared Gateway as <namespace>/<name>.
# WORKER_BASE_DOMAIN=localhost
# WORKER_GATEWAY=nimbus-gateway/nimbus
